APP_NAME="Pengisi Template CV"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
WEB_PORT=8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cvfiller
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=redis
REDIS_CLIENT=predis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

LOG_CHANNEL=stderr
LOG_LEVEL=info

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Langkah AI opsional (hanya backend, tidak pernah dikirim ke frontend). Kosong = nonaktif.
# Penyedia: claude | openai | gemini. Bisa juga diatur dari antarmuka aplikasi (tombol "AI").
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

FILE_RETENTION_HOURS=24
